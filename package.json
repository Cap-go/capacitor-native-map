{
  "name": "@capgo/capacitor-native-map",
  "version": "0.0.1",
  "description": "Native maps for Capacitor: Google Maps on Android, Apple MapKit on iOS, Google Maps JS on web",
  "license": "MPL-2.0",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapgoCapacitorNativeMap.podspec",
    "NOTICE",
    "THIRD_PARTY_LICENSES",
    "legal/"
  ],
  "author": "Martin Donadieu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cap-go/capacitor-native-map.git"
  },
  "bugs": {
    "url": "https://github.com/Cap-go/capacitor-native-map/issues"
  },
  "homepage": "https://capgo.app/docs/plugins/native-map/",
  "keywords": [
    "capacitor",
    "plugin",
    "maps",
    "google-maps",
    "mapkit",
    "capgo",
    "native"
  ],
  "scripts": {
    "verify": "bun run verify:ios && bun run verify:android && bun run verify:web",
    "verify:ios": "xcodebuild -scheme CapgoCapacitorNativeMap -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "bun run build",
    "lint": "bun run eslint && bun run prettier -- --check && bun run swiftlint -- lint",
    "fmt": "bun run eslint -- --fix && bun run prettier -- --write && bun run swiftlint -- --fix --format",
    "eslint": "eslint . --ext .ts",
    "prettier": "prettier-pretty-check \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api NativeMapPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "bun run clean && bun run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "example:install": "cd example-app && bun install",
    "example:build": "cd example-app && bun run build",
    "prepublishOnly": "bun run build",
    "check:wiring": "node scripts/check-capacitor-plugin-wiring.mjs",
    "check:cap9-deprecated": "node scripts/check-cap9-deprecated.mjs",
    "changelog:ai": "node scripts/generate-ai-changelog.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@types/google.maps": "^3.58.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/resize-observer-browser": "^0.1.11",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "prettier-pretty-check": "^0.2.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
